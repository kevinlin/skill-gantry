            "severity": "MEDIUM",
            "category": "Dangerous Code Execution",
            "pattern": "subprocess module call",
            "confidence": 0.7,
            "finding": "    proc = subprocess.run([binary, f\"-s={session}\", *args],\n                          capture_output=True, text=True, timeout=timeout)",
            "explanation": "subprocess module calls execute external commands. Without careful input validation, this enables command injection.",
            "remediation": "Use subprocess.run() with shell=False and an explicit argument list. Validate all inputs and avoid passing user-controlled data to commands.",
            "code_snippet": "\n\ndef _pw_cli(binary, session, args, timeout=90) -> str:\n    proc = subprocess.run([binary, f\"-s={session}\", *args],\n                          capture_output=True, text=True, timeout=timeout)\n    combined = proc.stdout + proc.stderr\n    if \"### Error\" in combined:",
            "tags": [
              "Dangerous Code Execution"
            ]
          }
        },
