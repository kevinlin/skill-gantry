{
  "name": "skillgantry",
  "version": "0.3.1",
  "type": "module",
  "bin": {
    "skillgantry": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "install:cli": "scripts/install-cli.sh",
    "lint": "eslint src tests",
    "test": "vitest run",
    "acceptance": "SG_ACCEPTANCE=1 vitest run tests/acceptance",
    "test:integration": "SG_INTEGRATION=1 SG_ACCEPTANCE=1 vitest run tests/core/install.test.ts tests/core/suppress-integration.test.ts tests/acceptance",
    "check": "pnpm lint && pnpm build && pnpm test && pnpm acceptance"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "uuid": "^14.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "eslint": "^9.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
