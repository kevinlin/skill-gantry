{
  "name": "skillgantry",
  "version": "1.1.2",
  "type": "module",
  "bin": {
    "skillgantry": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "install:cli": "scripts/install-cli.sh",
    "release:version": "scripts/release-version.sh",
    "lint": "eslint src tests",
    "test": "vitest run",
    "acceptance": "SG_ACCEPTANCE=1 vitest run tests/acceptance",
    "test:integration": "SG_INTEGRATION=1 SG_ACCEPTANCE=1 vitest run tests/core/install.test.ts tests/core/suppress-integration.test.ts tests/acceptance",
    "check": "pnpm lint && pnpm build && pnpm test && pnpm acceptance"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "uuid": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
